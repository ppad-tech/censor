cabal-version:      3.0
name:               ppad-censor
version:            0.3.1
synopsis:           Anytime-valid sequential constant-time testing.
license:            MIT
license-file:       LICENSE
author:             Jared Tobin
maintainer:         jared@ppad.tech
category:           Testing
build-type:         Simple
tested-with:        GHC == { 9.10.3 }
extra-doc-files:    CHANGELOG
description:
  A pure Haskell framework for sequential constant-time testing via
  anytime-valid e-processes. Declare a constant-time hypothesis (an
  @IO@ action plus two input samplers); the driver interleaves paired
  timings of the two input classes and streams them through
  ppad-eproc's two-sample test, halting as soon as the wealth process
  crosses threshold.

flag llvm
  description: Use GHC's LLVM backend.
  default:     False
  manual:      True

flag demo
  description: Build the censor-demo executable (depends on ppad-fixed,
               ppad-secp256k1, ppad-aead, ppad-sha256, ppad-sha512,
               and ppad-bip32).
  default:     False
  manual:      True

flag demo-ffi
  description: Build the censor-demo-ffi executable, which exercises
               'Censor.FFI' against the Rust static library produced
               by 'rs-demo' (provided at link time via extra-lib-dirs).
  default:     False
  manual:      True

flag validate
  description: Build the censor-validate executable, which runs the
               empirical calibration battery (synthetic-meter false-
               positive sweep + power table).
  default:     False
  manual:      True

flag poly
  description: Build the censor-poly executable, which records
               ppad-poly1305 constant-time MAC comparison traces
               under a selectable meter (depends on ppad-poly1305).
  default:     False
  manual:      True

flag sha
  description: Build the censor-sha executable, which records
               ppad-sha256 constant-time MAC comparison traces
               under a selectable meter (depends on ppad-sha256).
  default:     False
  manual:      True

flag sha512
  description: Build the censor-sha512 executable, which records
               ppad-sha512 constant-time MAC comparison traces
               under a selectable meter (depends on ppad-sha512).
  default:     False
  manual:      True

flag aead
  description: Build the censor-aead executable, which records
               ppad-aead ChaCha20-Poly1305 encrypt/decrypt traces
               under a selectable meter (depends on ppad-aead).
  default:     False
  manual:      True

flag secp
  description: Build the censor-secp executable, which records
               ppad-secp256k1 secret-scalar surface traces (mul,
               mul_wnaf, ecdh, ECDSA/Schnorr signing) under a
               selectable meter (depends on ppad-secp256k1,
               ppad-fixed).
  default:     False
  manual:      True

flag run
  description: Build the `censor` executable, a dlopen-based runner
               that drives a constant-time hypothesis against a
               foreign target resolved from a shared library.
  default:     False
  manual:      True

flag integration
  description: Build the censor-integration test suite, which drives
               a compiled C shim through 'Censor.Runner.DL' end-to-end.
               Requires a working C compiler on PATH; not available on
               Windows.
  default:     False
  manual:      True

source-repository head
  type:     git
  location: git.ppad.tech/censor.git

library
  default-language: Haskell2010
  hs-source-dirs:   lib
  ghc-options:
      -Wall
  c-sources: cbits/censor_env.c
  if flag(llvm)
    ghc-options: -fllvm -O2
  if !os(windows)
    c-sources: cbits/censor_dl.c
  if os(linux)
    c-sources: cbits/censor_perf.c
    extra-libraries: dl
  exposed-modules:
      Censor
      Censor.FFI
      Censor.Meter
      Censor.Rng
      Censor.Runner
      Censor.Runner.DL
      Censor.Runner.Env
      Censor.Runner.Report
  other-modules:
      Paths_ppad_censor
  autogen-modules:
      Paths_ppad_censor
  build-depends:
      base >= 4.9 && < 5
    , bytestring >= 0.9 && < 0.13
    , ppad-eproc >= 0.4 && < 0.5

test-suite censor-tests
  type:                exitcode-stdio-1.0
  default-language:    Haskell2010
  hs-source-dirs:      test
  main-is:             Main.hs

  ghc-options:
    -rtsopts -Wall -O2

  build-depends:
      base
    , bytestring
    , ppad-censor
    , tasty
    , tasty-hunit

benchmark censor-bench
  type:                exitcode-stdio-1.0
  default-language:    Haskell2010
  hs-source-dirs:      bench
  main-is:             Main.hs

  ghc-options:
    -rtsopts -O2 -Wall -fno-warn-orphans
  if flag(llvm)
    ghc-options: -fllvm

  build-depends:
      base
    , criterion
    , deepseq
    , ppad-censor

benchmark censor-weigh
  type:                exitcode-stdio-1.0
  default-language:    Haskell2010
  hs-source-dirs:      bench
  main-is:             Weight.hs

  ghc-options:
    -rtsopts -O2 -Wall -fno-warn-orphans
  if flag(llvm)
    ghc-options: -fllvm

  build-depends:
      base
    , deepseq
    , ppad-censor
    , weigh

executable censor-demo
  default-language: Haskell2010
  hs-source-dirs:   demo
  main-is:          Main.hs
  ghc-options:
    -O2 -rtsopts -Wall

  if !flag(demo)
    buildable: False
  else
    build-depends:
        base
      , bytestring
      , ppad-aead
      , ppad-bip32
      , ppad-censor
      , ppad-fixed
      , ppad-secp256k1
      , ppad-sha256 >= 0.3.4 && < 0.4
      , ppad-sha512

executable censor-viz
  default-language: Haskell2010
  hs-source-dirs:   demo
  main-is:          Viz.hs
  ghc-options:
    -O2 -rtsopts -Wall

  if !flag(demo)
    buildable: False
  else
    build-depends:
        base
      , ppad-censor
      , ppad-eproc
      , ppad-fixed
      , ppad-secp256k1

executable censor-poly
  default-language: Haskell2010
  hs-source-dirs:   demo
  main-is:          Poly.hs
  ghc-options:
    -O2 -rtsopts -Wall

  if !flag(poly)
    buildable: False
  else
    build-depends:
        base
      , bytestring
      , ppad-censor
      , ppad-eproc
      , ppad-poly1305

executable censor-sha
  default-language: Haskell2010
  hs-source-dirs:   demo
  main-is:          Sha.hs
  ghc-options:
    -O2 -rtsopts -Wall

  if !flag(sha)
    buildable: False
  else
    build-depends:
        base
      , bytestring
      , ppad-censor
      , ppad-eproc
      , ppad-sha256

executable censor-sha512
  default-language: Haskell2010
  hs-source-dirs:   demo
  main-is:          Sha512.hs
  ghc-options:
    -O2 -rtsopts -Wall

  if !flag(sha512)
    buildable: False
  else
    build-depends:
        base
      , bytestring
      , ppad-censor
      , ppad-eproc
      , ppad-sha512

executable censor-aead
  default-language: Haskell2010
  hs-source-dirs:   demo
  main-is:          Aead.hs
  ghc-options:
    -O2 -rtsopts -Wall

  if !flag(aead)
    buildable: False
  else
    build-depends:
        base
      , bytestring
      , ppad-censor
      , ppad-aead

executable censor-secp
  default-language: Haskell2010
  hs-source-dirs:   demo
  main-is:          Secp.hs
  ghc-options:
    -O2 -rtsopts -Wall

  if !flag(secp)
    buildable: False
  else
    build-depends:
        base
      , bytestring
      , ppad-censor
      , ppad-secp256k1
      , ppad-fixed

executable censor-demo-ffi
  default-language: Haskell2010
  hs-source-dirs:   demo-ffi
  main-is:          Main.hs
  ghc-options:
    -O2 -rtsopts -Wall

  if !flag(demo-ffi)
    buildable: False
  else
    build-depends:
        base
      , ppad-censor
    extra-libraries:
        censor_rs_demo

executable censor-validate
  default-language: Haskell2010
  hs-source-dirs:   validate
  main-is:          Main.hs
  ghc-options:
    -O2 -rtsopts -Wall

  if !flag(validate)
    buildable: False
  else
    build-depends:
        base
      , ppad-censor

executable censor
  default-language: Haskell2010
  hs-source-dirs:   run
  main-is:          Main.hs
  ghc-options:
    -O2 -rtsopts -Wall

  if !flag(run)
    buildable: False
  else
    build-depends:
        base
      , ppad-censor

test-suite censor-integration
  type:                exitcode-stdio-1.0
  default-language:    Haskell2010
  hs-source-dirs:      test-integration
  main-is:             Main.hs

  ghc-options:
    -rtsopts -Wall -O2

  if !flag(integration) || os(windows)
    buildable: False
  else
    build-depends:
        base
      , ppad-censor
      , process
      , tasty
      , tasty-hunit
